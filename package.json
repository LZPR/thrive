{
    "name": "sillytavern-thrive",
    "version": "0.37.1",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24.15.0 || >=26.0.0"
    },
    "scripts": {
        "check:syntax": "node scripts/check-syntax.mjs",
        "test:smoke": "node --experimental-vm-modules smoke-import.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "npm run check:syntax && npm run lint && npm run typecheck && npm run test:smoke",
        "lint": "eslint .",
        "typecheck": "tsc -p jsconfig.json",
        "test:e2e": "playwright test",
        "test:all": "npm run check && npm test && npm run test:e2e"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
