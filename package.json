{
    "name": "sillytavern-thrive",
    "version": "0.37.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "check:syntax": "node scripts/check-syntax.mjs",
        "test:smoke": "node --experimental-vm-modules smoke-import.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check": "npm run check:syntax && npm run test:smoke && npm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
